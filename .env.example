# ==============================================================================
# FairResolve — Environment Configuration
# Copy this file to '.env' in the project root:
#   cp .env.example .env
# ==============================================================================

# Server Port & Mode
PORT=3000
NODE_ENV=development
DEMO_MODE=true

# Public Application URL & CORS Origins
# On Railway, set APP_BASE_URL to your generated https://<service>.up.railway.app URL
APP_BASE_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Session & CSRF Signing Secret (set a strong random 64-char hex string in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Storage & Single-Instance Worker Settings (Railway Volume mounts at /app/data)
FAIRRESOLVE_STORAGE_DIR="/app/data"
SERVICE_TYPE="app"
RUN_IN_PROCESS_WORKER="true"

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI API (Optional for Live Multimodal Vision Analysis)
# Get your free API key at: https://aistudio.google.com/app/apikey
# If left blank, FairResolve runs in deterministic policy baseline mode.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 2. PAYPAL DEVELOPER SANDBOX (Optional for Live Sandbox Payments)
# Get Sandbox credentials at: https://developer.paypal.com/dashboard/applications/sandbox
# Create a Sandbox App to obtain your Client ID and Client Secret.
# If left blank, FairResolve runs in high-fidelity Sandbox Simulation mode.
# ------------------------------------------------------------------------------
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_LIVE_ENABLED="false"

# ------------------------------------------------------------------------------
# 3. DATABASE (PostgreSQL required in production / Railway)
# If left blank in development, FairResolve uses local ACID JSON in data/.
# In Railway, link a managed PostgreSQL service to populate DATABASE_URL automatically.
# ------------------------------------------------------------------------------
# DATABASE_URL="postgres://fairresolve:fairresolve_secret@localhost:5432/fairresolve"
